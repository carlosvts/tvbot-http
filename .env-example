# ═══════════════════════════════════════════════════════════════════════════
#  CEREBRO (server)
# ═══════════════════════════════════════════════════════════════════════════

# ─── Rede ──────────────────────────────────────────────────────────────────
BIND_HOST=0.0.0.0
TCP_PORT=9876

# ─── Áudio (precisa bater com o .env da TV Box) ────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=30

# ─── Wake word ─────────────────────────────────────────────────────────────
# Pré-treinada: hey_jarvis | alexa | hey_mycroft | hey_rhasspy | timer | weather
# Customizada : caminho absoluto dentro do container, ex:
#               /models/wakeword/tvbot.onnx
OWW_MODEL=hey_jarvis
OWW_THRESHOLD=0.5
OWW_INFERENCE_FRAMEWORK=onnx
OWW_COOLDOWN_S=2.0

# ─── Captura da frase: VAD com teto de tempo ───────────────────────────────
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=800
MAX_UTTERANCE_S=8.0
INITIAL_SPEECH_TIMEOUT_S=3.0
MIN_SPEECH_MS=300

# ─── STT (faster-whisper) ──────────────────────────────────────────────────
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1

# ─── Portal (API do site RAG) ──────────────────────────────────────────────
PORTAL_API_URL=http://host.docker.internal:8000/api/chat
PORTAL_TIMEOUT_S=90
PORTAL_SESSION_ID=

# ─── TTS (Piper, PT-BR) ────────────────────────────────────────────────────
PIPER_VOICE=/models/piper/pt_BR-faber-medium.onnx
PIPER_LENGTH_SCALE=1.0
TTS_MAX_CHARS=900

# ─── Comportamento ─────────────────────────────────────────────────────────
SEND_BEEP=true
PLAYBACK_GUARD_S=0.8
LOG_LEVEL=INFO